# Ghostwire — fish shell syntax-highlight colors
# Merge into ~/.config/fish/config.fish, or:
#   source ~/.config/omarchy/current/theme/colors.fish

set -g fish_color_normal c8d2e6
set -g fish_color_command 50dcc8
set -g fish_color_keyword 9664dc
set -g fish_color_quote dcb43c
set -g fish_color_redirection 3fc4de
set -g fish_color_end 3a4250
set -g fish_color_error dc5050
set -g fish_color_param d8e1f2
set -g fish_color_comment 3a4250
set -g fish_color_selection --background=1c2740
set -g fish_color_search_match --background=1c2740
set -g fish_color_operator 50dcc8
set -g fish_color_escape 9664dc
set -g fish_color_autosuggestion 3a4250
set -g fish_color_cancel dc5050
set -g fish_color_cwd 50dcc8
set -g fish_color_cwd_root dc5050
set -g fish_color_valid_path --underline

set -g fish_pager_color_prefix 9664dc --bold
set -g fish_pager_color_completion c8d2e6
set -g fish_pager_color_description 3a4250
set -g fish_pager_color_progress 50dcc8
set -g fish_pager_color_selected_background --background=1c2740
