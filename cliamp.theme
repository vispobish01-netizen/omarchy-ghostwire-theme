# Ghostwire — cliamp theme
# cliamp loads themes from ~/.config/cliamp/themes/*.toml (filename minus
# .toml = theme name shown in its theme picker). Install:
#   mkdir -p ~/.config/cliamp/themes
#   cp cliamp.theme ~/.config/cliamp/themes/ghostwire.toml
# Then pick "ghostwire" from cliamp's theme selector.
#
# cliamp's Theme struct only exposes 6 hex fields (accent, brightfg, fg,
# green, yellow, red) — no dedicated background/blue/purple slots — so this
# maps 1:1 onto the same values used everywhere else in the theme.

name = "Ghostwire"
accent = "#50dcc8"
brightfg = "#e8f7f4"
fg = "#c8d2e6"
green = "#50c878"
yellow = "#dcb43c"
red = "#dc5050"
