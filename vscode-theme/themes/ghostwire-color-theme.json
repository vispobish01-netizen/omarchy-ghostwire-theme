    "sideBarSectionHeader.border": "#1a2233",
    "list.activeSelectionBackground": "#1c2740",
    "list.activeSelectionForeground": "#e8f7f4",
    "list.inactiveSelectionBackground": "#182031",
    "list.hoverBackground": "#151b26",
    "list.highlightForeground": "#50dcc8",
    "tree.indentGuidesStroke": "#1a2233",

    "statusBar.background": "#08090d",
    "statusBar.foreground": "#c8d2e6",
    "statusBar.border": "#1a2233",
    "statusBar.debuggingBackground": "#dc5050",
    "statusBar.debuggingForeground": "#06070c",
