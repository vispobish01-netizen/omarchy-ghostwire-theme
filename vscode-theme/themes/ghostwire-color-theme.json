    "extensionButton.prominentBackground": "#50dcc8",
    "extensionButton.prominentForeground": "#06070c",
    "extensionButton.prominentHoverBackground": "#6be4e6"
  },
  "tokenColors": [
    {
      "settings": { "foreground": "#c8d2e6" }
    },
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#3a4250", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.quoted", "punctuation.definition.string"],
      "settings": { "foreground": "#50c878" }
    },
    {
      "scope": ["constant.numeric", "constant.language.boolean", "constant.language"],
      "settings": { "foreground": "#fab795" }
    },
    {
      "scope": ["variable", "variable.other.readwrite", "meta.definition.variable"],
      "settings": { "foreground": "#d8e1f2" }
    },
    {
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#d8e1f2", "fontStyle": "italic" }
    },
    {
      "scope": ["variable.language", "variable.language.this", "constant.language.this"],
      "settings": { "foreground": "#b98ae8", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
      "settings": { "foreground": "#9664dc", "fontStyle": "bold" }
    },
    {
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#3fc4de" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#50dcc8", "fontStyle": "bold" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.class", "storage.type.class"],
      "settings": { "foreground": "#3fc4de" }
    },
    {
      "scope": ["entity.other.inherited-class"],
      "settings": { "foreground": "#3fc4de", "fontStyle": "italic" }
    },
    {
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#9664dc" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#fab795" }
    },
    {
      "scope": ["support.type.property-name", "meta.object-literal.key"],
      "settings": { "foreground": "#6fb0e8" }
    },
    {
      "scope": ["punctuation", "meta.brace", "punctuation.definition.parameters"],
      "settings": { "foreground": "#7a8aa8" }
    },
    {
      "scope": ["keyword.control.import", "keyword.control.from", "meta.import"],
      "settings": { "foreground": "#6be4e6" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#dc5050" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold", "foreground": "#e8f7f4" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "scope": ["markup.heading"],
      "settings": { "foreground": "#50dcc8", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": { "foreground": "#dcb43c" }
    },
    {
      "scope": ["markup.underline.link"],
      "settings": { "foreground": "#50dcc8" }
    }
  ]
}
