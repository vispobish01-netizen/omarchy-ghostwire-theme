{
  "name": "Ghostwire",
  "type": "dark",
  "colors": {
    "focusBorder": "#50dcc8",
    "foreground": "#c8d2e6",
    "descriptionForeground": "#c8d2e6",
    "errorForeground": "#dc5050",

    "editor.background": "#08090d",
    "editor.foreground": "#c8d2e6",
    "editorCursor.foreground": "#50dcc8",
    "editorLineNumber.foreground": "#3a4250",
    "editorLineNumber.activeForeground": "#50dcc8",
    "editor.selectionBackground": "#1c2740",
    "editor.selectionHighlightBackground": "#1c274080",
    "editor.inactiveSelectionBackground": "#1c274066",
    "editor.lineHighlightBackground": "#151b26",
    "editor.wordHighlightBackground": "#1c274080",
    "editor.findMatchBackground": "#9664dc55",
    "editor.findMatchHighlightBackground": "#3fc4de33",
    "editorIndentGuide.background1": "#1a2233",
    "editorIndentGuide.activeBackground1": "#3fc4de55",
    "editorWhitespace.foreground": "#1a2233",
    "editorRuler.foreground": "#1a2233",

    "activityBar.background": "#06070c",
    "activityBar.foreground": "#50dcc8",
    "activityBar.inactiveForeground": "#3a4250",
    "activityBar.border": "#1a2233",
    "activityBarBadge.background": "#9664dc",
    "activityBarBadge.foreground": "#06070c",

    "sideBar.background": "#08090d",
    "sideBar.border": "#1a2233",
    "sideBar.foreground": "#c8d2e6",
    "sideBarTitle.foreground": "#e8f7f4",
    "sideBarSectionHeader.background": "#08090d",
    "sideBarSectionHeader.border": "#1a2233",
    "list.activeSelectionBackground": "#1c2740",
    "list.activeSelectionForeground": "#e8f7f4",
    "list.inactiveSelectionBackground": "#1c274066",
    "list.hoverBackground": "#151b26",
    "list.highlightForeground": "#50dcc8",
    "tree.indentGuidesStroke": "#1a2233",

    "statusBar.background": "#08090d",
    "statusBar.foreground": "#c8d2e6",
    "statusBar.border": "#1a2233",
    "statusBar.debuggingBackground": "#dc5050",
    "statusBar.debuggingForeground": "#06070c",
    "statusBar.noFolderBackground": "#06070c",
    "statusBarItem.hoverBackground": "#151b26",
    "statusBarItem.remoteBackground": "#50dcc8",
    "statusBarItem.remoteForeground": "#06070c",

    "titleBar.activeBackground": "#090c11",
    "titleBar.activeForeground": "#c8d2e6",
    "titleBar.inactiveBackground": "#06070c",
    "titleBar.inactiveForeground": "#3a4250",
    "titleBar.border": "#1a2233",

    "tab.activeBackground": "#08090d",
    "tab.activeForeground": "#e8f7f4",
    "tab.activeBorder": "#50dcc8",
    "tab.inactiveBackground": "#090c11",
    "tab.inactiveForeground": "#3a4250",
    "tab.border": "#1a2233",
    "editorGroupHeader.tabsBackground": "#090c11",
    "editorGroupHeader.tabsBorder": "#1a2233",

    "terminal.background": "#08090d",
    "terminal.foreground": "#c8d2e6",
    "terminal.ansiBlack": "#08090d",
    "terminal.ansiRed": "#dc5050",
    "terminal.ansiGreen": "#50c878",
    "terminal.ansiYellow": "#dcb43c",
    "terminal.ansiBlue": "#3fc4de",
    "terminal.ansiMagenta": "#9664dc",
    "terminal.ansiCyan": "#50dcc8",
    "terminal.ansiWhite": "#c8d2e6",
    "terminal.ansiBrightBlack": "#3a4250",
    "terminal.ansiBrightRed": "#ec6a88",
    "terminal.ansiBrightGreen": "#7ee8a8",
    "terminal.ansiBrightYellow": "#fab795",
    "terminal.ansiBrightBlue": "#6fb0e8",
    "terminal.ansiBrightMagenta": "#b98ae8",
    "terminal.ansiBrightCyan": "#6be4e6",
    "terminal.ansiBrightWhite": "#e8f7f4",

    "input.background": "#090c11",
    "input.foreground": "#e8f7f4",
    "input.border": "#1a2233",
    "input.placeholderForeground": "#3a4250",
    "inputOption.activeBorder": "#50dcc8",

    "dropdown.background": "#090c11",
    "dropdown.foreground": "#c8d2e6",
    "dropdown.border": "#1a2233",

    "badge.background": "#9664dc",
    "badge.foreground": "#06070c",

    "scrollbarSlider.background": "#1c274080",
    "scrollbarSlider.hoverBackground": "#1a2233",
    "scrollbarSlider.activeBackground": "#3fc4de55",

    "progressBar.background": "#50dcc8",

    "notificationCenterHeader.background": "#090c11",
    "notifications.background": "#090c11",
    "notifications.foreground": "#c8d2e6",
    "notifications.border": "#1a2233",
    "notificationLink.foreground": "#50dcc8",

    "peekView.border": "#50dcc8",
    "peekViewEditor.background": "#090c11",
    "peekViewResult.background": "#06070c",
    "peekViewResult.selectionBackground": "#1c2740",
    "peekViewResult.selectionForeground": "#e8f7f4",

    "gitDecoration.addedResourceForeground": "#50c878",
    "gitDecoration.modifiedResourceForeground": "#dcb43c",
    "gitDecoration.deletedResourceForeground": "#dc5050",
    "gitDecoration.untrackedResourceForeground": "#50dcc8",
    "gitDecoration.ignoredResourceForeground": "#3a4250",

    "button.background": "#50dcc8",
    "button.foreground": "#06070c",
    "button.hoverBackground": "#6be4e6",
    "button.secondaryBackground": "#151b26",
    "button.secondaryForeground": "#c8d2e6",
    "button.secondaryHoverBackground": "#1c2740",
    "extensionButton.prominentBackground": "#50dcc8",
    "extensionButton.prominentForeground": "#06070c",
    "extensionButton.prominentHoverBackground": "#6be4e6"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#3a4250", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "punctuation.definition.string"],
      "settings": { "foreground": "#50c878" }
    },
    {
      "scope": ["constant.numeric", "constant.language"],
      "settings": { "foreground": "#fab795" }
    },
    {
      "scope": ["variable", "variable.other"],
      "settings": { "foreground": "#d8e1f2" }
    },
    {
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#d8e1f2", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#b98ae8", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#9664dc", "fontStyle": "bold" }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#3fc4de" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type"],
      "settings": { "foreground": "#50dcc8", "fontStyle": "bold" }
    },
    {
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#3fc4de" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#3fc4de", "fontStyle": "italic" }
    },
    {
      "scope": ["constant.other.symbol", "constant.other.key"],
      "settings": { "foreground": "#9664dc" }
    },
    {
      "scope": ["constant.character.escape"],
      "settings": { "foreground": "#fab795" }
    },
    {
      "scope": ["support.type.property-name", "meta.object-literal.key"],
      "settings": { "foreground": "#6fb0e8" }
    },
    {
      "scope": ["punctuation", "meta.brace", "punctuation.definition.parameters"],
      "settings": { "foreground": "#d8e1f2" }
    },
    {
      "scope": ["keyword.control.import", "keyword.control.from", "meta.import"],
      "settings": { "foreground": "#6be4e6" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#dc5050" }
    },
    {
      "scope": ["markup.heading"],
      "settings": { "fontStyle": "bold", "foreground": "#e8f7f4" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "scope": ["markup.link"],
      "settings": { "foreground": "#50dcc8", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.raw.inline", "markup.raw.block"],
      "settings": { "foreground": "#dcb43c" }
    },
    {
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#50dcc8" }
    },
    {
      "scope": ["markup.changed"],
      "settings": { "foreground": "#dcb43c" }
    },
    {
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#dc5050" }
    }
  ]
}
