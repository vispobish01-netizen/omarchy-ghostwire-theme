    "pickerGroup.border": "#1a2233",

    "diffEditor.insertedTextBackground": "#50c87822",
    "diffEditor.removedTextBackground": "#dc505022",

    "gitDecoration.modifiedResourceForeground": "#dcb43c",
    "gitDecoration.addedResourceForeground": "#50c878",
    "gitDecoration.deletedResourceForeground": "#dc5050",
    "gitDecoration.untrackedResourceForeground": "#3fc4de",
    "gitDecoration.ignoredResourceForeground": "#3a4250",
    "gitDecoration.conflictingResourceForeground": "#dc5050",

    "peekView.border": "#50dcc8",
    "peekViewEditor.background": "#090c11",
    "peekViewResult.background": "#08090d",
