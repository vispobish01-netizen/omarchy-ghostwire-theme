{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Ghostwire",
  "author": "Ghostwire theme",
  "themes": [
    {
      "name": "Ghostwire",
      "appearance": "dark",
      "style": {
        "border": "#1a2233ff",
        "border.variant": "#1a2333ff",
        "border.focused": "#50dcc8ff",
        "border.selected": "#9664dcff",
        "background": "#08090dff",
        "surface.background": "#090c11ff",
        "elevated_surface.background": "#151b26ff",
        "text": "#c8d2e6ff",
        "text.muted": "#3a4250ff",
        "text.accent": "#50dcc8ff",
        "icon": "#c8d2e6ff",
        "icon.muted": "#3a4250ff",
        "element.background": "#151b26ff",
        "element.hover": "#1c2740ff",
        "element.selected": "#1c2740ff",
        "tab_bar.background": "#06070cff",
        "tab.active_background": "#08090dff",
        "tab.inactive_background": "#090c11ff",
        "editor.background": "#08090dff",
        "editor.foreground": "#c8d2e6ff",
        "editor.gutter.background": "#08090dff",
        "editor.line_number": "#3a4250ff",
        "editor.active_line_number": "#50dcc8ff",
        "editor.active_line.background": "#151b26ff",
        "editor.selection.background": "#1c274066",
        "editor.cursor": "#50dcc8ff",
        "terminal.background": "#08090dff",
        "terminal.foreground": "#c8d2e6ff",
        "terminal.ansi.black": "#08090dff",
        "terminal.ansi.red": "#dc5050ff",
        "terminal.ansi.green": "#50c878ff",
        "terminal.ansi.yellow": "#dcb43cff",
        "terminal.ansi.blue": "#3fc4deff",
        "terminal.ansi.magenta": "#9664dcff",
        "terminal.ansi.cyan": "#50dcc8ff",
        "terminal.ansi.white": "#c8d2e6ff",
        "terminal.ansi.bright_black": "#3a4250ff",
        "terminal.ansi.bright_red": "#ec6a88ff",
        "terminal.ansi.bright_green": "#7ee8a8ff",
        "terminal.ansi.bright_yellow": "#fab795ff",
        "terminal.ansi.bright_blue": "#6fb0e8ff",
        "terminal.ansi.bright_magenta": "#b98ae8ff",
        "terminal.ansi.bright_cyan": "#6be4e6ff",
        "terminal.ansi.bright_white": "#e8f7f4ff",
        "syntax": {
          "keyword": { "color": "#9664dcff", "font_style": null, "font_weight": null },
          "function": { "color": "#50dcc8ff", "font_style": null, "font_weight": null },
          "string": { "color": "#dcb43cff", "font_style": null, "font_weight": null },
          "comment": { "color": "#3a4250ff", "font_style": "italic", "font_weight": null },
          "type": { "color": "#3fc4deff", "font_style": null, "font_weight": null },
          "variable": { "color": "#c8d2e6ff", "font_style": null, "font_weight": null },
          "constant": { "color": "#ec6a88ff", "font_style": null, "font_weight": null },
          "property": { "color": "#6fb0e8ff", "font_style": null, "font_weight": null },
          "number": { "color": "#fab795ff", "font_style": null, "font_weight": null }
        }
      }
    }
  ]
